#!/usr/bin/env bash
# ai-awsvault-stop - Stops the AWS credential server
set -euo pipefail
source "$(dirname "$0")/_common.sh"

# Parse arguments
JSON_OUTPUT=false
CLEAR_URL=false

while [[ $# -gt 0 ]]; do
  case "$1" in
    --json)
      JSON_OUTPUT=true
      shift
      ;;
    --clear)
      CLEAR_URL=true
      shift
      ;;
    -h|--help)
      echo "Usage: ai-awsvault-stop [OPTIONS]"
      echo
      echo "Options:"
      echo "  --clear     Clear the saved credential URL"
      echo "  --json      Output in JSON format for MCP integration"
      echo "  -h, --help  Show this help message"
      echo
      exit 0
      ;;
    *)
      _red "Unknown option: $1"
      exit 1
      ;;
  esac
done

PORT="${PORT:-9099}"
PID_FOUND=""
SERVER_STOPPED=false
URL_CLEARED=false

# Function to find and kill aws-vault process
kill_aws_vault() {
  local aws_vault_pid=""
  
  # First try to get PID from saved file
  if [[ -f "$HOME/.ai/awsvault_pid" ]]; then
    aws_vault_pid=$(cat "$HOME/.ai/awsvault_pid" 2>/dev/null || echo "")
    # Verify the process exists and is aws-vault
    if [[ -n "$aws_vault_pid" ]] && ! ps -p "$aws_vault_pid" -o command= | grep -q aws-vault; then
      if ! $JSON_OUTPUT; then
        _yellow "Saved PID $aws_vault_pid is not an aws-vault process"
      fi
      aws_vault_pid=""
    fi
  # Also try legacy location
  elif [[ -f "$HOME/.cc/awsvault_pid" ]]; then
    aws_vault_pid=$(cat "$HOME/.cc/awsvault_pid" 2>/dev/null || echo "")
    # Verify the process exists and is aws-vault
    if [[ -n "$aws_vault_pid" ]] && ! ps -p "$aws_vault_pid" -o command= | grep -q aws-vault; then
      if ! $JSON_OUTPUT; then
        _yellow "Saved PID $aws_vault_pid is not an aws-vault process"
      fi
      aws_vault_pid=""
    fi
  fi
  
  # Fall back to port-based detection if PID not found or invalid
  if [[ -z "$aws_vault_pid" ]]; then
    aws_vault_pid=$(lsof -t -i :"$PORT" 2>/dev/null | grep -E "^[0-9]+$" || echo "")
  fi
  
  # If still no PID, try to find any aws-vault process running with --ecs-server
  if [[ -z "$aws_vault_pid" ]]; then
    aws_vault_pid=$(pgrep -f "aws-vault.*--ecs-server" || echo "")
  fi
  
  if [[ -n "$aws_vault_pid" ]]; then
    PID_FOUND="$aws_vault_pid"
    
    if ! $JSON_OUTPUT; then
      _green "Stopping aws-vault credential server (PID: $aws_vault_pid)..."
    fi
    
    kill "$aws_vault_pid" 2>/dev/null || true
    
    # Wait for process to terminate
    local counter=0
    while kill -0 "$aws_vault_pid" 2>/dev/null && [[ $counter -lt 10 ]]; do
      sleep 0.2
      counter=$((counter + 1))
    done
    
    if kill -0 "$aws_vault_pid" 2>/dev/null; then
      if ! $JSON_OUTPUT; then
        _yellow "Process did not terminate gracefully, forcing..."
      fi
      kill -9 "$aws_vault_pid" 2>/dev/null || true
    fi
    
    # Clean up PID files in both locations
    if [[ -f "$HOME/.ai/awsvault_pid" ]]; then
      rm "$HOME/.ai/awsvault_pid"
    fi
    if [[ -f "$HOME/.cc/awsvault_pid" ]]; then
      rm "$HOME/.cc/awsvault_pid"
    fi
    
    # Verify it's gone
    if ! pgrep -f "aws-vault.*--ecs-server" | grep -q "$aws_vault_pid"; then
      if ! $JSON_OUTPUT; then
        _green "AWS credential server stopped successfully"
      fi
      SERVER_STOPPED=true
      return 0
    else
      if ! $JSON_OUTPUT; then
        _red "Failed to stop AWS credential server"
      fi
      return 1
    fi
  else
    if ! $JSON_OUTPUT; then
      _yellow "No aws-vault credential server found"
    fi
    return 0
  fi
}

# Option to clear the saved URL
if $CLEAR_URL; then
  # Clear from both locations
  if [[ -f "$HOME/.ai/awsvault_url" ]]; then
    rm "$HOME/.ai/awsvault_url"
    URL_CLEARED=true
  fi
  if [[ -f "$HOME/.ai/env/awsvault_url" ]]; then
    rm "$HOME/.ai/env/awsvault_url"
    URL_CLEARED=true
  fi
  # Legacy location
  if [[ -f "$HOME/.cc/awsvault_url" ]]; then
    rm "$HOME/.cc/awsvault_url"
    URL_CLEARED=true
  fi
  
  if URL_CLEARED && ! $JSON_OUTPUT; then
    _green "Removed saved credential URL"
  fi
fi

# Try to stop the server
kill_aws_vault
STOP_RESULT=$?

# List any remaining aws-vault processes
remaining=$(pgrep -f "aws-vault.*(--server|--ecs-server)" || echo "")
REMAINING_COUNT=0
if [[ -n "$remaining" ]]; then
  REMAINING_COUNT=$(echo "$remaining" | wc -l)
  if ! $JSON_OUTPUT; then
    _yellow "Other aws-vault processes still running:"
    ps -p "$remaining" -o pid,command || true
  fi
fi

# Format output based on mode
if $JSON_OUTPUT; then
  cat <<EOF
{
  "success": $(if [[ $STOP_RESULT -eq 0 ]]; then echo true; else echo false; fi),
  "pid_found": "$(if [[ -n "$PID_FOUND" ]]; then echo "$PID_FOUND"; else echo "null"; fi)",
  "server_stopped": $SERVER_STOPPED,
  "url_cleared": $URL_CLEARED,
  "remaining_processes": $REMAINING_COUNT
}
EOF
fi

exit $STOP_RESULT